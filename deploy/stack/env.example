# GENERATED — DO NOT EDIT.
#
# Source: internal/surface (vocabularies), internal/clispec (commands),
#         internal/surfacescan (routes, schema, environment).
# Regenerate: make surface-gen     Verify: make surface-check
#
# Hand edits are reverted by the next regeneration and fail CI in the meantime.
# To change what this says, change the declaration it is generated from.
#
# /opt/partyline/.env on a partyline box. Copy it there, fill in real values, chmod 600.
# Never commit the filled version. CI upserts a subset of these on every deploy (the
# "Sync CI-managed runtime env" step in .github/workflows/deploy-prod.yml); everything else is
# hand-set on the box once by scripts/env-bootstrap.sh, or appended to .env by hand.
#
# RULE: staging must never reach a customer. Every outbound integration below either gets a
# staging-specific credential or is left EMPTY so the feature stays dark. Do not paste prod values.
#
# The values shown are STAGING examples. Generate every secret with: openssl rand -base64 32
#
# `ptln server doctor` reads the same registry this file is generated from and reports each
# feature configured / not-configured, naming the variables a not-configured one is missing.

# ─── Core — the app does not run correctly without these ─────────────────────────────────
# NEXT_PUBLIC_SITE_URL — the site origin the browser bundle links to
NEXT_PUBLIC_SITE_URL=https://staging.partyline.sh
# NEXT_PUBLIC_SUPABASE_ANON_KEY — the legacy name for the anon PostgREST key, still read as a
#   fallback so a box whose .env predates the rename keeps working; set PGRST_ANON_KEY on a new box
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_URL — the legacy name for PostgREST's origin, still read as a fallback so
#   a box whose .env predates the rename keeps working; set PGRST_URL on a new box
NEXT_PUBLIC_SUPABASE_URL=
# NODE_ENV — set by Next itself; production/development
NODE_ENV=
# PGRST_ANON_KEY — the anon JWT the server-side PostgREST client presents
PGRST_ANON_KEY=
# PGRST_URL — PostgREST's origin, read at RUNTIME so one image can serve both boxes
PGRST_URL=http://postgrest:3000
# SESSION_JWT_SECRET — signs our session JWTs; must be byte-identical to PGRST_JWT_SECRET and
#   TRIMMED — a trailing newline mints tokens PostgREST silently rejects
SESSION_JWT_SECRET=
# SITE_URL — the canonical origin every server-rendered link and email is built from
SITE_URL=https://staging.partyline.sh
# SUPABASE_SERVICE_ROLE_KEY — the admin bypass every adminClient() call uses — treat as root
SUPABASE_SERVICE_ROLE_KEY=

# ─── Read by docker compose and the init scripts, not by application code ──────────────────
# AUTHENTICATOR_PASSWORD — PostgREST's login role; must match the bootstrap in
#   deploy/stack/init/
AUTHENTICATOR_PASSWORD=
# BIND_ADDR — the host interface every published port binds to; unset = 0.0.0.0, which is what
#   an unqualified "80:80" already meant. Set 127.0.0.1, a LAN address or a Tailscale IP to stop
#   publishing on every NIC
BIND_ADDR=0.0.0.0
# CADDY_IMAGE — overrides the WHOLE Caddy image reference. The stock image has no DNS provider
#   modules, so this is how you run a build that does — the only route to a real certificate on a
#   box the public internet cannot reach (DNS-01 proves you own the name, not that the box is
#   reachable)
CADDY_IMAGE=
# CADDY_REPLICAS — set 0 to stop running the bundled Caddy — the no-reverse-proxy mode, with
#   docker-compose.direct.yml; unset = 1
CADDY_REPLICAS=1
# HTTPS_PORT — the host port Caddy publishes for HTTPS; unset = 443. Same caveat as HTTP_PORT
HTTPS_PORT=443
# HTTP_PORT — the host port Caddy publishes for HTTP; unset = 80. Moving it means Let's Encrypt
#   can no longer validate this box, so use it only behind another proxy
HTTP_PORT=80
# KEYCLOAK_PORT — with docker-compose.direct.yml, the host port Keycloak publishes — sign-in
#   is a browser redirect to it, so it needs one when there is no proxy; unset = 8081
KEYCLOAK_PORT=
# MINIO_REPLICAS — set 0 to stop running the bundled MinIO on a box that points S3_* at R2 or
#   S3; unset = 1
MINIO_REPLICAS=1
# MINIO_ROOT_PASSWORD — the bundled MinIO's root password, generated by scripts/env-bootstrap.sh
#   — never a default
MINIO_ROOT_PASSWORD=
# MINIO_ROOT_USER — the bundled MinIO's root user, generated by scripts/env-bootstrap.sh
MINIO_ROOT_USER=partyline
# OIDC_PUBLIC_URL — the base URL a BROWSER reaches Keycloak on, including /auth; compose passes
#   it as KC_HOSTNAME. Unset = SITE_URL/auth, which is right behind Caddy. It must equal OIDC_ISSUER
#   minus /realms/<realm> or discovery refuses the document
OIDC_PUBLIC_URL=
# POSTGRES_PASSWORD — the database superuser password (openssl rand -base64 32)
POSTGRES_PASSWORD=
# RELAY_IMAGE — overrides the WHOLE relay image reference; the only way to pin a digest, since @
#   is illegal in a tag. Unset = whatever RELAY_TAG names
RELAY_IMAGE=
# RELAY_PORT — the host port the relay publishes; unset = 2222. It used to be 22 on our own box
#   because a relay hostname was compiled into the CLI — nothing is now, so pick whatever does not
#   collide with sshd
RELAY_PORT=2222
# RELAY_TAG — the relay image tag compose runs; upserted by the deploy workflow alongside
#   WEB_TAG
RELAY_TAG=latest
# WEB_IMAGE — overrides the WHOLE web image reference, e.g.
#   ghcr.io/partyline-sh/partyline-web@sha256:… or your own mirror. Unset = whatever WEB_TAG names
WEB_IMAGE=
# WEB_PORT — with docker-compose.direct.yml, the host port the web app publishes directly; unset
#   = 8080. Ignored when Caddy is the edge
WEB_PORT=
# WEB_TAG — the image tag compose runs; upserted by the deploy workflow, set by hand to pin or
#   roll back. The images are public — see deploy/stack/README.md for pinning
WEB_TAG=latest

# ══════════════════════════════════════════════════════════════════════════════════════════
# FEATURES — one block per entry in features.json.
#
# A feature is CONFIGURED when every variable in its block is set, and NOT CONFIGURED otherwise.
# Two states, no middle: leaving a block empty is a supported choice and the feature stays dark.

# ─── [admin_console] Operator console ───────────────────────────────────────────────────────
PARTYLINE_ADMIN_EMAILS=

# ─── [discord] Discord bot ──────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=

# ─── [email] Transactional email (Resend) ───────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=

# ─── [github_app] GitHub App ────────────────────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_APP_SLUG=

# ─── [github_webhook] GitHub webhook (board reconciliation) ─────────────────────────────────
GITHUB_WEBHOOK_SECRET=

# ─── [invite_assertions] Invite-only join assertions ────────────────────────────────────────
PARTYLINE_ASSERT_KEY=

# ─── [oidc] Authentication (generic OIDC) ───────────────────────────────────────────────────
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=

# ─── [redis] Redis ──────────────────────────────────────────────────────────────────────────
REDIS_URL=

# ─── [relay] Relay (pppp.sh) ────────────────────────────────────────────────────────────────
RELAY_ID=
RELAY_SECRET=

# ─── [scribe] Scribe (server-side distillation) ─────────────────────────────────────────────
PARTYLINE_SCRIBE_KEY=

# ─── [session_key_wrap] Session key encryption at rest ──────────────────────────────────────
SESSION_KEY_WRAP=

# ─── [slack] Slack app ──────────────────────────────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# ─── [storage] Object storage (S3 API — MinIO ships in the stack; R2/S3 by changing these four) ───
S3_ACCESS_KEY_ID=
S3_BUCKET=
S3_ENDPOINT=
S3_SECRET_ACCESS_KEY=

# ─── [telegram] Telegram bot ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ─── [ticker] Ticker (scheduled sweeps) ─────────────────────────────────────────────────────
TICK_SECRET=

# ─── Optional — a supported unset state with a documented default ────────────────────────
# AUTH_PROVIDER — which sign-in adapter to use; unset = oidc, which is the only one
AUTH_PROVIDER=oidc
# NEXT_RUNTIME — set by Next itself per runtime; read to keep the self-tick out of the edge
#   runtime
NEXT_RUNTIME=
# OIDC_ALLOW_INSECURE_ISSUER — accept a plain-http OIDC_ISSUER on a non-loopback host; unset =
#   refuse, which is the only safe default on a public network. Set it ONLY on a private network
#   (LAN, VPN, Tailscale) that has no certificate — over http the JWKS can be rewritten in flight
#   and a rewritten JWKS verifies a forged token
OIDC_ALLOW_INSECURE_ISSUER=
# OIDC_REDIRECT_URI — the generic OIDC callback; falls back to SITE_URL + /api/auth/callback
OIDC_REDIRECT_URI=
# OIDC_SCOPES — scopes requested from the OIDC issuer; unset = "openid email profile", which is
#   what the profile mapping needs
OIDC_SCOPES=
# PARTYLINE_CLI_NOTICE — one-line notice shown to CLIs on their update check; empty = none
PARTYLINE_CLI_NOTICE=
# PARTYLINE_MARKETING_ONLY — set to 1 to serve ONLY the documentation and marketing pages,
#   404ing the application half — this is what partyline.sh itself runs, and it is the opposite of
#   what a self-hoster wants. LEAVE IT UNSET: setting it on your own instance turns the product off
PARTYLINE_MARKETING_ONLY=
# PARTYLINE_MIN_CLI — minimum supported CLI version; unset = 0.0.0, nothing is gated
PARTYLINE_MIN_CLI=
# PARTYLINE_REVIEW_PORT — local port the review host listens on (127.0.0.1 only); unset = 7391
PARTYLINE_REVIEW_PORT=7391
# PARTYLINE_SCRIBE_MODEL — overrides the scribe's default model
PARTYLINE_SCRIBE_MODEL=
# PARTYLINE_SCRIBE_PROVIDER — overrides the scribe's default provider (anthropic)
PARTYLINE_SCRIBE_PROVIDER=
# PARTYLINE_SELF_TICK — set to 1 to have the web process POST its own 60s maintenance tick (the
#   compose stack sets it — it replaced the ticker container). Unset = an external scheduler is
#   expected to hit /api/v1/tick
PARTYLINE_SELF_TICK=
# R2_ACCESS_KEY_ID — legacy name still honoured as a fallback for S3_ACCESS_KEY_ID; do not set
#   on a new box
R2_ACCESS_KEY_ID=
# R2_BUCKET — legacy name still honoured as a fallback for S3_BUCKET; do not set on a new box
R2_BUCKET=
# R2_ENDPOINT — legacy name still honoured as a fallback for S3_ENDPOINT; do not set on a new
#   box
R2_ENDPOINT=
# R2_SECRET_ACCESS_KEY — legacy name still honoured as a fallback for S3_SECRET_ACCESS_KEY; do
#   not set on a new box
R2_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE — overrides object-storage addressing; unset = path style for a bare host
#   (MinIO), virtual-hosted otherwise
S3_FORCE_PATH_STYLE=
# S3_REGION — object-storage region; unset = auto, which R2 and MinIO accept. Real AWS S3 needs
#   the bucket's region
S3_REGION=
# SLACK_STATE_SECRET — signs the Slack OAuth CSRF state; falls back to SESSION_JWT_SECRET, which
#   is the #175 footgun — set it to finish the split
SLACK_STATE_SECRET=
# SUPABASE_JWT_SECRET — legacy name still honoured as a fallback for SLACK_STATE_SECRET; do not
#   set on a new box
SUPABASE_JWT_SECRET=
