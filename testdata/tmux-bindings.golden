bind -n M-8 select-window -t 8
bind -n M-9 select-window -t 9
set-hook -g client-detached 'run-shell '\''PTLN tmux --detached'\'''
set-hook -g window-unlinked 'run-shell '\''PTLN tmux --save-workspace'\'''
set-hook -g session-window-changed 'run-shell -b '\''PTLN tmux --contractors-seen #{window_id}'\'''
bind -n MouseDown1Status if -F '#{m:window,#{mouse_status_range}}' { select-window -t = } { run-shell -b 'PTLN tmux --contractor-click #{mouse_status_range}' }
