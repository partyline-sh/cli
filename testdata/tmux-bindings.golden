set -s extended-keys on
set -as terminal-features "xterm*:extkeys"
set -g mouse on
bind -T copy-mode MouseDragEnd1Pane send -X copy-pipe-no-clear 'CLIPBOARD' \; run-shell -b 'PTLN tmux --copied'
bind -T copy-mode-vi MouseDragEnd1Pane send -X copy-pipe-no-clear 'CLIPBOARD' \; run-shell -b 'PTLN tmux --copied'
bind -T copy-mode Enter send -X copy-pipe-no-clear 'CLIPBOARD' \; run-shell -b 'PTLN tmux --copied'
bind -T copy-mode-vi Enter send -X copy-pipe-no-clear 'CLIPBOARD' \; run-shell -b 'PTLN tmux --copied'
bind -T copy-mode MouseDown1Pane { select-pane; send -X clear-selection }
bind -T copy-mode-vi MouseDown1Pane { select-pane; send -X clear-selection }
bind -T copy-mode MouseUp1Pane { send -X cancel }
bind -T copy-mode-vi MouseUp1Pane { send -X cancel }
bind -n WheelUpPane if -F '#{?#{alternate_on},#{mouse_any_flag},0}' { send -M } { copy-mode -e; send -M }
bind -T copy-mode '!' { if -F '#{pane_in_mode}' { send -X cancel }; send-keys -l -- '!' }
bind -T copy-mode '"' { if -F '#{pane_in_mode}' { send -X cancel }; send-keys -l -- '"' }
bind -T copy-mode '#' { if -F '#{pane_in_mode}' { send -X cancel }; send-keys -l -- '#' }
