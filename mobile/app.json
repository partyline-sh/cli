{
  "expo": {
    "name": "Partyline",
    "slug": "partyline-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "sh.partyline.mobile",
      "buildNumber": "10"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1b1a19",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "sh.partyline.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Partyline to scan your computer\u2019s pairing QR code.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Partyline to attach photos to your messages.",
          "cameraPermission": "Allow Partyline to scan your computer\u2019s pairing QR code.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "partyline",
    "updates": {
      "enabled": false
    }
  }
}
